# Maintainer: Comet
#
# Packages a binary that has already been built.
#
# The build itself needs Node and a full Rust toolchain and takes a few minutes,
# so this deliberately does not do it: CI builds `comet` (see
# .github/workflows/release.yml), drops the binary next to this file, and runs
# `makepkg -f`. That keeps the package building in seconds, which is what
# somebody installing it wants.
#
# To do it by hand:
#   1. npm ci && npx tauri build --no-bundle      (in web/)
#   2. copy web/src-tauri/target/release/comet here, with comet.desktop,
#      comet-x11, comet-x11.desktop, com.comet.desktop, comet.png (from
#      web/src-tauri/icons/128x128.png) and LICENSE (from the top of the
#      repository)
#   3. makepkg -f
pkgname=comet
pkgver=1.0.2
pkgrel=1
pkgdesc="A local-first workspace for notes and files"
arch=('x86_64')
url="https://github.com/MarchTheDev/Comet"
license=('GPL-3.0-only')
# WebKitGTK draws the interface. The GStreamer plugins are not optional for
# audible media and webkit2gtk-4.1 does not ask for them: it depends only on
# the plugin libraries, not the plugin files that carry the elements.
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg' 'openssl'
         'libsoup3' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugin-pipewire')
optdepends=('gnome-keyring: store the password-vault key' 'kwallet: store the password-vault key on KDE')
options=('!strip')
source=('comet' 'comet.desktop' 'comet-x11' 'comet-x11.desktop' 'com.comet.desktop' 'comet.png' 'LICENSE')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/comet" "$pkgdir/usr/bin/comet"
  install -Dm755 "$srcdir/comet-x11" "$pkgdir/usr/bin/comet-x11"
  install -Dm644 "$srcdir/comet.desktop" "$pkgdir/usr/share/applications/comet.desktop"
  install -Dm644 "$srcdir/comet-x11.desktop" "$pkgdir/usr/share/applications/comet-x11.desktop"
  # Wayland panels ask for the application id, not the binary name.
  install -Dm644 "$srcdir/com.comet.desktop" "$pkgdir/usr/share/applications/com.comet.desktop"
  install -Dm644 "$srcdir/comet.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/comet.png"
  install -Dm644 "$srcdir/comet.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/com.comet.png"
  # The licence text itself, so the package says what the program is under
  # without this file carrying thirty-five kilobytes of it.
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
