{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comet",
  "version": "1.0.1",
  "identifier": "com.comet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Comet",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "../../packaging/windows/nsis-header.bmp",
        "sidebarImage": "../../packaging/windows/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "../../packaging/windows/wix-banner.bmp",
        "dialogImagePath": "../../packaging/windows/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pipewire"
        ],
        "files": {
          "/usr/bin/comet-x11": "../../packaging/linux/comet-x11",
          "/usr/share/applications/comet-x11.desktop": "../../packaging/linux/comet-x11.desktop",
          "/usr/share/applications/com.comet.desktop": "../../packaging/linux/com.comet.desktop",
          "/usr/share/icons/hicolor/128x128/apps/com.comet.png": "icons/128x128.png"
        }
      },
      "rpm": {
        "depends": [
          "libappindicator-gtk3",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "pipewire-gstreamer"
        ],
        "files": {
          "/usr/bin/comet-x11": "../../packaging/linux/comet-x11",
          "/usr/share/applications/comet-x11.desktop": "../../packaging/linux/comet-x11.desktop",
          "/usr/share/applications/com.comet.desktop": "../../packaging/linux/com.comet.desktop",
          "/usr/share/icons/hicolor/128x128/apps/com.comet.png": "icons/128x128.png"
        }
      }
    }
  }
}
